{
  "name": "avscope-unified",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "rm -rf .next .turbo && next dev --turbopack",
    "dev:auto": "node scripts/dev-with-auto-clean.js",
    "build": "next build --turbopack",
    "build:clean": "rm -rf .next .turbo && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "clean": "rm -rf .next .turbo",
    "clean:all": "rm -rf .next .turbo node_modules/.cache",
    "generate:articles": "node scripts/generate-articles.js",
    "articles:auto-generate": "node --env-file=.env.local scripts/auto-generate-article.mjs",
    "sitemap:fetch:actresses": "bash scripts/fetch-actresses.sh",
    "sitemap:fetch:genres": "bash scripts/fetch-genres.sh",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "sitemap:generate:articles": "node scripts/generate-sitemap.js --articles-only",
    "sitemap:generate:main": "tsx scripts/generate-sitemaps.ts",
    "sitemap:generate:items": "node scripts/generate-item-sitemap.mjs",
    "sitemap:all": "npm run sitemap:fetch:actresses && npm run sitemap:fetch:genres && npm run sitemap:generate",
    "sitemap:all:main": "npm run sitemap:generate:main",
    "sitemap:local": "npm run sitemap:generate:main && npm run sitemap:generate:items",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/kv": "^3.0.0",
    "google-auth-library": "^11.0.0",
    "google-spreadsheet": "^5.3.0",
    "gray-matter": "^4.0.3",
    "next": "15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.3.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^2.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
